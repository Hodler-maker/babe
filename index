<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Veux-tu être ma petite amie ?</title>
<style>
  :root{
    --pink-1:#ffd9e6;
    --pink-2:#ffc0d9;
    --pink-3:#ffe6ef;
    --red-1:#ff2d6f;
    --red-2:#e0115f;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;
    padding:0;
    height:100%;
    width:100%;
    overflow:hidden;
    font-family:'Trebuchet MS','Segoe UI',sans-serif;
    background:radial-gradient(circle at 30% 20%, #ffe3ee, #ffc9dd 45%, #ffb8d1 100%);
  }

  .bg-hearts{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:0;
  }
  .bg-heart{
    position:absolute;
    opacity:.55;
    filter:drop-shadow(0 4px 8px rgba(255,45,111,.15));
    animation:float 8s ease-in-out infinite;
  }
  @keyframes float{
    0%,100%{ transform: translateY(0) rotate(0deg); }
    50%{ transform: translateY(-18px) rotate(6deg); }
  }

  .stage{
    position:relative;
    z-index:2;
    height:100%;
    width:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:20px;
    transition:opacity .4s ease;
  }

  .gift{
    font-size:56px;
    margin-bottom:10px;
    animation:bob 2.4s ease-in-out infinite;
    filter:drop-shadow(0 6px 10px rgba(224,17,95,.25));
  }
  @keyframes bob{
    0%,100%{ transform:translateY(0) rotate(-3deg); }
    50%{ transform:translateY(-12px) rotate(3deg); }
  }

  h1{
    font-size:clamp(2.1rem, 6vw, 4rem);
    line-height:1.1;
    margin:6px 0 14px;
    color:var(--red-1);
    text-shadow:0 3px 0 rgba(255,255,255,.5);
    animation:pop .6s ease;
  }
  @keyframes pop{
    0%{ transform:scale(.85); opacity:0; }
    100%{ transform:scale(1); opacity:1; }
  }

  .subtitle{
    color:#a04066;
    font-size:1.05rem;
    margin-bottom:34px;
    opacity:.85;
  }

  .buttons{
    position:relative;
    display:flex;
    gap:22px;
    align-items:center;
    justify-content:center;
    min-height:80px;
    width:100%;
    max-width:520px;
  }

  .btn{
    border:none;
    border-radius:50px;
    font-size:1.15rem;
    font-weight:700;
    padding:18px 42px;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease;
    font-family:inherit;
  }

  .btn-yes{
    background:linear-gradient(135deg, var(--red-1), var(--red-2));
    color:#fff;
    box-shadow:0 10px 25px rgba(224,17,95,.4);
  }
  .btn-yes:hover{
    transform:scale(1.06);
    box-shadow:0 14px 30px rgba(224,17,95,.5);
  }
  .btn-yes:active{ transform:scale(.97); }

  .btn-no{
    position:relative;
    background:#fff5f8;
    color:var(--red-2);
    box-shadow:0 6px 16px rgba(224,17,95,.15);
    transition:transform .18s ease, left .18s ease, top .18s ease;
  }
  .btn-no.runaway{
    position:fixed;
  }

  .hint{
    margin-top:26px;
    font-size:.85rem;
    color:#b4587c;
    opacity:.75;
  }

  /* Loading screen */
  .loading-screen{
    position:fixed;
    inset:0;
    z-index:5;
    display:none;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    background:radial-gradient(circle at 50% 30%, #ffe3ee, #ffb8d1 100%);
    text-align:center;
    padding:20px;
  }
  .loading-screen.show{ display:flex; }

  .loading-heart{
    font-size:60px;
    margin-bottom:20px;
    animation:bob 1.6s ease-in-out infinite;
  }

  .loading-steps{
    width:100%;
    max-width:420px;
    display:flex;
    flex-direction:column;
    gap:22px;
  }

  .step{
    opacity:.35;
    transition:opacity .3s ease;
  }
  .step.active{ opacity:1; }
  .step.done{ opacity:.7; }

  .step-label{
    color:var(--red-2);
    font-weight:700;
    font-size:1rem;
    margin-bottom:8px;
    text-align:left;
  }

  .bar-track{
    width:100%;
    height:14px;
    border-radius:20px;
    background:rgba(255,255,255,.6);
    box-shadow:inset 0 2px 4px rgba(224,17,95,.15);
    overflow:hidden;
  }

  .bar-fill{
    height:100%;
    width:0%;
    border-radius:20px;
    background:linear-gradient(135deg, var(--red-1), var(--red-2));
    transition:width 1.1s ease;
  }

  /* Celebration screen */
  .celebration{
    position:fixed;
    inset:0;
    z-index:5;
    display:none;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    text-align:center;
    background:radial-gradient(circle at 50% 30%, #ffe3ee, #ffb8d1 100%);
  }
  .celebration.show{ display:flex; }
  .celebration .big-emoji{
    font-size:80px;
    animation:pop .5s ease;
  }
  .celebration h2{
    font-size:clamp(1.8rem, 5vw, 3rem);
    color:var(--red-1);
    margin:10px 0;
  }
  .celebration p{
    color:#a04066;
    font-size:1.1rem;
    max-width:500px;
  }

  .rising-heart{
    position:fixed;
    bottom:-30px;
    z-index:6;
    pointer-events:none;
    font-size:22px;
    opacity:.9;
    animation:rise linear forwards;
  }
  @keyframes rise{
    to{ transform:translateY(-110vh); opacity:0; }
  }
</style>
</head>
<body>

<div class="bg-hearts" id="bgHearts"></div>

<div class="stage" id="stage">
  <div class="gift">🎁</div>
  <h1>Veux-tu être<br>ma petite amie ?</h1>
  <p class="subtitle">Une question très importante...</p>

  <div class="buttons" id="buttons">
    <button class="btn btn-yes" id="yesBtn">Oui ! 💕</button>
    <button class="btn btn-no" id="noBtn">Non</button>
  </div>

  <p class="hint">Conseil : le bouton "Non" est un peu timide... 😄</p>
</div>

<div class="loading-screen" id="loadingScreen">
  <div class="loading-heart">💞</div>
  <div class="loading-steps" id="loadingSteps">
    <div class="step" data-step="0">
      <div class="step-label">Connexion des cœurs en cours.... 💗</div>
      <div class="bar-track"><div class="bar-fill"></div></div>
    </div>
    <div class="step" data-step="1">
      <div class="step-label">Préparation des papillons ... 🦋</div>
      <div class="bar-track"><div class="bar-fill"></div></div>
    </div>
    <div class="step" data-step="2">
      <div class="step-label">Chargement de l'amour..... 💖</div>
      <div class="bar-track"><div class="bar-fill"></div></div>
    </div>
    <div class="step" data-step="3">
      <div class="step-label">Synchronisation des battements .... 🫀</div>
      <div class="bar-track"><div class="bar-fill"></div></div>
    </div>
  </div>
</div>

<div class="celebration" id="celebration">
  <div class="big-emoji">🎉💖</div>
  <h2>Je savais que tu allais dire oui 😍</h2>
  <p>Tu viens d'officialiser la plus belle histoire. À partir de maintenant, c'est nous deux contre le monde. ❤️</p>
</div>

<script>
  // Floating background hearts
  const bgHearts = document.getElementById('bgHearts');
  const heartEmojis = ['💗','💖','💕','❤️','💘'];
  for(let i=0;i<14;i++){
    const h = document.createElement('div');
    h.className = 'bg-heart';
    h.textContent = heartEmojis[Math.floor(Math.random()*heartEmojis.length)];
    h.style.left = Math.random()*95 + '%';
    h.style.top = Math.random()*90 + '%';
    h.style.fontSize = (14 + Math.random()*22) + 'px';
    h.style.animationDelay = (Math.random()*5) + 's';
    h.style.animationDuration = (6 + Math.random()*4) + 's';
    bgHearts.appendChild(h);
  }

  // "Non" button dodges the cursor / taps
  const noBtn = document.getElementById('noBtn');
  const stage = document.getElementById('stage');

  const noPhrases = [
    "Non",
    "T'es sûre ?",
    "Réfléchis bien",
    "Allez, dis oui !",
    "S'il te plaît 🥺",
    "Tu me brises le cœur 💔",
    "Dernière chance",
    "Non non non",
    "Je vais pleurer",
    "Pourquoi pas ?"
  ];
  let noIndex = 0;

  function moveNoButton(){
    const margin = 60;
    const w = window.innerWidth;
    const h = window.innerHeight;

    noIndex = (noIndex + 1) % noPhrases.length;
    noBtn.textContent = noPhrases[noIndex];

    const btnW = noBtn.offsetWidth;
    const btnH = noBtn.offsetHeight;

    const newLeft = margin + Math.random() * (w - btnW - margin*2);
    const newTop = margin + Math.random() * (h - btnH - margin*2);

    if(!noBtn.classList.contains('runaway')){
      noBtn.classList.add('runaway');
    }
    noBtn.style.left = newLeft + 'px';
    noBtn.style.top = newTop + 'px';
  }

  noBtn.addEventListener('mouseenter', moveNoButton);
  noBtn.addEventListener('click', (e) => { e.preventDefault(); moveNoButton(); });
  noBtn.addEventListener('touchstart', (e) => { e.preventDefault(); moveNoButton(); }, {passive:false});

  // "Oui" button triggers celebration
  const yesBtn = document.getElementById('yesBtn');
  const celebration = document.getElementById('celebration');

  function launchHearts(){
    const emojis = ['💖','💕','💗','❤️'];
    for(let i=0;i<10;i++){
      const heart = document.createElement('div');
      heart.className = 'rising-heart';
      heart.textContent = emojis[Math.floor(Math.random()*emojis.length)];
      heart.style.left = Math.random()*100 + 'vw';
      heart.style.animationDuration = (4 + Math.random()*2) + 's';
      heart.style.animationDelay = (Math.random()*1.5) + 's';
      heart.style.fontSize = (16 + Math.random()*14) + 'px';
      document.body.appendChild(heart);
      setTimeout(()=>heart.remove(), 8000);
    }
  }

  const loadingScreen = document.getElementById('loadingScreen');
  const stepEls = document.querySelectorAll('.step');

  function runLoadingSequence(){
    loadingScreen.classList.add('show');
    let i = 0;

    function nextStep(){
      if(i > 0){
        stepEls[i-1].classList.remove('active');
        stepEls[i-1].classList.add('done');
      }
      if(i >= stepEls.length){
        setTimeout(()=>{
          loadingScreen.classList.remove('show');
          celebration.classList.add('show');
          launchHearts();
          setInterval(launchHearts, 3500);
        }, 400);
        return;
      }
      const current = stepEls[i];
      current.classList.add('active');
      const fill = current.querySelector('.bar-fill');
      requestAnimationFrame(()=>{ fill.style.width = '100%'; });
      i++;
      setTimeout(nextStep, 1300);
    }

    nextStep();
  }

  yesBtn.addEventListener('click', () => {
    stage.style.opacity = '0';
    setTimeout(()=>{
      stage.style.display = 'none';
      runLoadingSequence();
    }, 350);
  });
</script>

</body>
</html>
